<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký tài khoản mới | PHONGTROHN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { background-color: #f0f2f5; font-family: 'Segoe UI', sans-serif; height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
        .auth-container { max-width: 900px; width: 95%; background: #fff; border-radius: 20px; overflow: hidden; display: flex; box-shadow: 0 20px 40px rgba(0,0,0,0.15); height: 600px; }
        .auth-banner { width: 45%; position: relative; background-image: url('https://png.pngtree.com/background/20250803/original/pngtree-cinematic-lighting-in-penthouse-background-picture-image_16237987.jpg'); background-size: cover; background-position: center; display: flex; flex-direction: column; justify-content: flex-end; padding: 40px 30px; }
        .auth-banner::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 50%); z-index: 1; }
        .banner-text { position: relative; z-index: 2; color: #fff; }
        .auth-form { width: 55%; padding: 50px; display: flex; flex-direction: column; justify-content: center; }
        .btn-submit { background-color: #007bff; color: white; border: none; padding: 14px; border-radius: 10px; font-weight: bold; width: 100%; transition: 0.3s; }
        .btn-submit:hover { background-color: #0056b3; transform: translateY(-2px); }
        .form-control { padding: 12px 12px 12px 45px; border-radius: 10px; border: 1px solid #dee2e6; background-color: #f8f9fa; }
        .input-group-custom { position: relative; margin-bottom: 1.2rem; }
        .input-icon { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #adb5bd; z-index: 10; }
        .divider { display: flex; align-items: center; text-align: center; margin: 25px 0; color: #adb5bd; font-size: 13px; }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid #eee; }
        @media (max-width: 768px) { .auth-banner { display: none; } .auth-form { width: 100%; } .auth-container { height: auto; } }
    </style>
</head>
<body>

<div class="auth-container">
    <div class="auth-banner">
        <div class="banner-text">
            <h2 class="fw-bold mb-1">Tìm phòng trọ</h2>
            <p class="mb-0 fs-5 opacity-90">PHONGTROHN dẫn lối</p>
        </div>
    </div>
    <div class="auth-form">
        <h3 class="fw-bold mb-4">Xin chào bạn</h3>
        <form action="/register" method="POST">
            <div class="input-group-custom">
                <i class="bi bi-phone input-icon"></i>
                <input type="tel" name="phone" class="form-control" placeholder="Số điện thoại của bạn" required>
            </div>

            <div class="input-group-custom">
                <i class="bi bi-envelope input-icon"></i>
                <input type="email" name="email" class="form-control" placeholder="Địa chỉ Email của bạn" required>
            </div>

            <div class="input-group-custom">
                <i class="bi bi-shield-lock input-icon"></i>
                <input type="password" name="password" class="form-control" placeholder="Tạo mật khẩu" required>
            </div>

            <button type="submit" class="btn btn-submit shadow-sm mt-2">Tiếp tục đăng ký</button>
        </form>
        <div class="divider">Hoặc</div>
        <a href="/login" class="text-center text-decoration-none small fw-bold text-primary">Đã có tài khoản? Đăng nhập</a>
    </div>
</div>

<% if (locals.message) { %>
    <script>
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: '<%= locals.message_type || "info" %>',
            title: '<%= locals.message %>',
            showConfirmButton: false,
            timer: 3000
        });
    </script>
<% } %>

</body>
</html>
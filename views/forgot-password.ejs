<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên mật khẩu | PHONGTROHN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        body { background-color: #f0f2f5; font-family: 'Segoe UI', sans-serif; height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
        .auth-container { max-width: 900px; width: 95%; background: #fff; border-radius: 20px; overflow: hidden; display: flex; box-shadow: 0 20px 40px rgba(0,0,0,0.15); height: 550px; }

        .auth-banner { 
            width: 45%; 
            position: relative;
            background-image: url('https://png.pngtree.com/background/20250803/original/pngtree-cinematic-lighting-in-penthouse-background-picture-image_16237987.jpg');
            background-size: cover; background-position: center; display: flex; flex-direction: column; justify-content: flex-end; padding: 40px 30px;
        }

        .auth-banner::after { content: ""; position: absolute; bottom: 0; left: 0; right: 0; top: 0; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 50%); z-index: 1; }
        .banner-text { position: relative; z-index: 2; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }

        .auth-form { width: 55%; padding: 50px; display: flex; flex-direction: column; justify-content: center; }
        .btn-submit { background-color: #007bff; color: white; border: none; padding: 14px; border-radius: 10px; font-weight: bold; width: 100%; transition: all 0.3s ease; }
        .btn-submit:hover { background-color: #0056b3; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,123,255,0.3); }
        
        .form-control { padding: 12px 12px 12px 45px; border-radius: 10px; border: 1px solid #dee2e6; background-color: #f8f9fa; }
        .input-group-custom { position: relative; margin-bottom: 1.5rem; }
        .input-icon { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #adb5bd; z-index: 10; font-size: 1.1rem; }
        
        .link-blue { color: #007bff; text-decoration: none; font-weight: 600; }
        @media (max-width: 768px) { .auth-banner { display: none; } .auth-form { width: 100%; } }
    </style>
</head>
<body>

<div class="auth-container">
    <div class="auth-banner">
        <div class="banner-text">
            <h2 class="fw-bold mb-1">Tìm phòng trọ</h2>
            <p class="mb-0 fs-5 opacity-90">PHONGTROHN dẫn lối</p>
        </div>
    </div>

    <div class="auth-form">
        <div class="mb-4">
            <h3 class="fw-bold mb-1">Quên mật khẩu?</h3>
            <p class="text-muted">Nhập số điện thoại để đặt lại mật khẩu của bạn</p>
        </div>
        
        <form action="/forgot-password" method="POST">
            <div class="input-group-custom">
                <i class="bi bi-phone input-icon"></i>
                <input type="tel" name="phone" class="form-control" placeholder="Nhập số điện thoại đã đăng ký" required>
            </div>
            <button type="submit" class="btn btn-submit shadow-sm mt-3">Gửi mã xác thực</button>
        </form>   

        <div class="text-center mt-4">
            <a href="/login" class="link-blue small"><i class="bi bi-arrow-left"></i> Quay lại đăng nhập</a>
        </div>
    </div>
</div>

<% if (locals.message) { %>
    <script>
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: '<%= locals.message_type || "info" %>',
            title: '<%= locals.message %>',
            showConfirmButton: false,
            timer: 4000
        });
    </script>
<% } %>

</body>
</html>
<%- include('partials/header') %>

<style>
    .auth-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .auth-container {
        max-width: 900px;
        width: 100%;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        height: 550px;
    }
    .auth-banner {
        width: 45%;
        position: relative;
        background-image: url('https://png.pngtree.com/background/20250803/original/pngtree-cinematic-lighting-in-penthouse-background-picture-image_16237987.jpg');
        background-size: cover;
        background-position: center;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 40px 30px;
    }
    .auth-banner::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);
        z-index: 1;
    }
    .banner-text { position: relative; z-index: 2; color: #fff; }
    
    .auth-form {
        width: 55%;
        padding: 40px 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .form-control {
        padding: 12px 12px 12px 45px;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        background-color: #f8f9fa;
    }
    .input-group-custom { position: relative; margin-bottom: 1rem; }
    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #adb5bd;
        z-index: 10;
    }
    @media (max-width: 768px) {
        .auth-banner { display: none; }
        .auth-form { width: 100%; padding: 30px; }
        .auth-container { height: auto; }
    }
</style>

<div class="container auth-wrapper my-5">
    <div class="auth-container">
        <div class="auth-banner">
            <div class="banner-text">
                <h2 class="fw-bold mb-1">Tìm phòng trọ</h2>
                <p class="mb-0 fs-5 opacity-90">PHONGTROHN dẫn lối</p>
            </div>
        </div>

        <div class="auth-form">
            <div class="mb-4">
                <h3 class="fw-bold mb-1">Đổi mật khẩu</h3>
                <p class="text-muted small">Vui lòng nhập mật khẩu mới để bảo mật tài khoản</p>
            </div>

            <% if (typeof message !== 'undefined' && message && message.length > 0) { %>
                <div class="alert alert-<%= message_type %> py-2 small border-0 mb-3">
                    <i class="bi bi-info-circle me-1"></i> <%= message %>
                </div>
            <% } %>

            <form action="/change-password" method="POST">
                <div class="input-group-custom">
                    <i class="bi bi-shield-lock input-icon"></i>
                    <input type="password" name="oldPassword" class="form-control" placeholder="Mật khẩu cũ" required>
                </div>
                
                <div class="input-group-custom">
                    <i class="bi bi-key input-icon"></i>
                    <input type="password" name="newPassword" class="form-control" placeholder="Mật khẩu mới" required minlength="6">
                </div>
                
                <div class="input-group-custom">
                    <i class="bi bi-check2-circle input-icon"></i>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="Xác nhận mật khẩu mới" required>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold mt-2 shadow-sm">
                    Cập nhật mật khẩu
                </button>
            </form>

            <div class="text-center mt-4">
                <a href="/" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left"></i> Quay lại trang chủ</a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<% if (message && message.length > 0) { %>
    <script>
        const msgType = '<%= message_type %>'; 
        
        Swal.fire({
            icon: msgType.includes('success') ? 'success' : 'error',
            title: `<h2 class="fw-bold">${msgType.includes('success') ? "Thành công!" : "Thất bại!"}</h2>`,
            html: '<p class="fs-4 mt-2"><%= message %></p>', 
            confirmButtonText: 'Tuyệt vời',
            confirmButtonColor: '#007bff',
            padding: '2em', 
            background: '#fff',
            backdrop: `rgba(0,0,123,0.4)`,
            width: '450px', 
        }).then((result) => {
            if (result.isConfirmed && msgType.includes('success')) {
                window.location.href = '/'; 
            }
        });
    </script>
<% } %>

<%- include('partials/footer') %>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xác thực mã OTP | PHONGTROHN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        body { background-color: #f0f2f5; font-family: 'Segoe UI', sans-serif; height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
        .auth-container { max-width: 900px; width: 95%; background: #fff; border-radius: 20px; overflow: hidden; display: flex; box-shadow: 0 20px 40px rgba(0,0,0,0.15); height: 550px; }

        .auth-banner { 
            width: 45%; 
            position: relative;
            background-image: url('https://png.pngtree.com/background/20250803/original/pngtree-cinematic-lighting-in-penthouse-background-picture-image_16237987.jpg');
            background-size: cover; background-position: center; display: flex; flex-direction: column; justify-content: flex-end; padding: 40px 30px;
        }

        .auth-banner::after { content: ""; position: absolute; bottom: 0; left: 0; right: 0; top: 0; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 50%); z-index: 1; }
        .banner-text { position: relative; z-index: 2; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }

        .auth-form { width: 55%; padding: 50px; display: flex; flex-direction: column; justify-content: center; }
        
        .otp-input-container { margin-bottom: 1.5rem; }
        .otp-field {
            letter-spacing: 12px;
            font-size: 2.2rem;
            text-align: center;
            font-weight: 800;
            border-radius: 12px;
            border: 2px solid #dee2e6;
            background-color: #f8f9fa;
            color: #333;
            transition: all 0.3s ease;
        }
        .otp-field:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.25rem rgba(0,123,255,0.1);
            background-color: #fff;
            outline: none;
        }

        .btn-submit { background-color: #007bff; color: white; border: none; padding: 14px; border-radius: 10px; font-weight: bold; width: 100%; transition: all 0.3s ease; }
        .btn-submit:hover { background-color: #0056b3; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,123,255,0.3); }
        
        .link-blue { color: #007bff; text-decoration: none; font-weight: 600; }
        .timer-text { font-size: 0.85rem; color: #6c757d; margin-top: 15px; }

        @media (max-width: 768px) { .auth-banner { display: none; } .auth-form { width: 100%; } }
    </style>
</head>
<body>

<div class="auth-container">
    <div class="auth-banner">
        <div class="banner-text">
            <h2 class="fw-bold mb-1">Xác thực OTP</h2>
            <p class="mb-0 fs-5 opacity-90">Bảo mật tài khoản của bạn</p>
        </div>
    </div>

    <div class="auth-form">
        <div class="mb-4">
            <h3 class="fw-bold mb-1">Nhập mã xác thực</h3>
            <p class="text-muted small">Chúng tôi đã gửi mã 6 số đến Email của bạn. Vui lòng kiểm tra kỹ (kể cả hòm thư rác).</p>
        </div>
        
        <form action="/verify-otp" method="POST">
            <div class="otp-input-container">
                <input type="text" 
                       name="otp" 
                       class="form-control otp-field" 
                       placeholder="000000" 
                       maxlength="6" 
                       pattern="\d{6}" 
                       inputmode="numeric" 
                       required 
                       autofocus>
            </div>

            <button type="submit" class="btn btn-submit shadow-sm mb-2">Xác nhận mã</button>
            
            <div class="text-center mt-2">
                <p class="timer-text">Không nhận được mã? 
                    <a href="/forgot-password" class="link-blue small">Gửi lại yêu cầu</a>
                </p>
                <a href="/login" class="link-blue small"><i class="bi bi-arrow-left"></i> Quay lại đăng nhập</a>
            </div>
        </form>
    </div>
</div>

<script>
    function showToast(icon, title) {
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: icon,
            title: title,
            showConfirmButton: false,
            timer: 4000,
            timerProgressBar: true
        });
    }

    const flashMessage = "<%= locals.message ? locals.message : '' %>";
    const flashType = "<%= locals.message_type ? locals.message_type : '' %>";

    if (flashMessage && flashMessage.length > 0) {
        showToast(flashType || "info", flashMessage);
    }
</script>

</body>
</html>
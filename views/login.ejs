<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập | PHONGTROHN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        body { background-color: #f0f2f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
        .auth-container { max-width: 900px; width: 95%; background: #fff; border-radius: 20px; overflow: hidden; display: flex; box-shadow: 0 20px 40px rgba(0,0,0,0.15); height: 550px; }
        .auth-banner { width: 45%; position: relative; background-image: url('https://png.pngtree.com/background/20250803/original/pngtree-cinematic-lighting-in-penthouse-background-picture-image_16237987.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat; image-rendering: -webkit-optimize-contrast; display: flex; flex-direction: column; justify-content: flex-end; padding: 40px 30px; }
        .auth-banner::after { content: ""; position: absolute; bottom: 0; left: 0; right: 0; top: 0; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 50%); z-index: 1; }
        .banner-text { position: relative; z-index: 2; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
        .auth-form { width: 55%; padding: 50px; display: flex; flex-direction: column; justify-content: center; }
        .btn-submit { background-color: #007bff; color: white; border: none; padding: 14px; border-radius: 10px; font-weight: bold; width: 100%; transition: all 0.3s ease; }
        .btn-submit:hover { background-color: #0056b3; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,123,255,0.3); }
        .form-control { padding: 12px 12px 12px 45px; border-radius: 10px; border: 1px solid #dee2e6; background-color: #f8f9fa; }
        .form-control:focus { border-color: #007bff; background-color: #fff; box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.1); }
        .input-group-custom { position: relative; margin-bottom: 1.2rem; }
        .input-icon { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #adb5bd; z-index: 10; font-size: 1.1rem; }
        .divider { display: flex; align-items: center; text-align: center; margin: 25px 0; color: #adb5bd; font-size: 13px; }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid #eee; }
        .divider:not(:empty)::before { margin-right: .5em; }
        .divider:not(:empty)::after { margin-left: .5em; }
        .btn-google { border: 1px solid #dee2e6; border-radius: 10px; padding: 12px; display: flex; align-items: center; justify-content: center; text-decoration: none; color: #495057; font-weight: 600; transition: all 0.2s; background: #fff; }
        .btn-google:hover { background-color: #f8f9fa; border-color: #adb5bd; }
        .link-blue { color: #007bff; text-decoration: none; font-weight: 600; }
        .link-blue:hover { text-decoration: underline; }
        @media (max-width: 768px) { .auth-banner { display: none; } .auth-form { width: 100%; padding: 30px; } .auth-container { height: auto; border-radius: 15px; } }
    </style>
</head>
<body>

<div class="auth-container">
    <div class="auth-banner">
        <div class="banner-text">
            <h2 class="fw-bold mb-1">Tìm phòng trọ</h2>
            <p class="mb-0 fs-5 opacity-90">PHONGTROHN dẫn lối</p>
        </div>
    </div>

    <div class="auth-form">
        <div class="mb-4">
            <h3 class="fw-bold mb-1">Xin chào bạn</h3>
            <p class="text-muted">Đăng nhập để bắt đầu trải nghiệm</p>
        </div>
        
        <form action="/login" method="POST">
            <div class="input-group-custom">
                <i class="bi bi-person-circle input-icon"></i>
                <input type="text" name="phone" class="form-control" placeholder="Số điện thoại hoặc Email" required>
            </div>
            
            <div class="input-group-custom">
                <i class="bi bi-shield-lock input-icon"></i>
                <input type="password" name="password" class="form-control" placeholder="Mật khẩu" required>
            </div>

            <div class="d-flex justify-content-between mb-4 small">
                <label class="text-muted d-flex align-items-center" style="cursor: pointer;">
                    <input type="checkbox" name="remember" class="me-2"> Nhớ tài khoản
                </label>
                <a href="/forgot-password" class="link-blue">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-submit shadow-sm">Đăng nhập ngay</button>
        </form>

        <div class="divider">Hoặc tiếp tục với</div>

        <a href="/auth/google" class="btn btn-google">
            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" width="18" class="me-2" alt="Google">
            Google
        </a>

        <p class="text-center mt-4 mb-0 small text-muted">
            Chưa có tài khoản? <a href="/register" class="link-blue">Đăng ký mới</a>
        </p>
    </div>
</div>

<% if (locals.message) { %>
    <script>
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: '<%= locals.message_type || "info" %>',
            title: '<%= locals.message %>',
            showConfirmButton: false,
            timer: 3000
        });
    </script>
<% } %>

</body>
</html>
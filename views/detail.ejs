<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= room.title %> - Cho thuê phòng Hà Nội</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>

        .carousel-item img { 
            width: 100%; 
            height: 500px; 
            object-fit: cover; 
            border-radius: 10px; 
        }

        .carousel-indicators button {
            width: 10px !important;
            height: 10px !important;
            border-radius: 50% !important;
            background-color: #fff !important;
            margin: 0 5px !important;
            opacity: 0.6;
            border: none;
        }
        .carousel-indicators .active {
            opacity: 1 !important;
            background-color: #0d6efd !important;
            transform: scale(1.2);
        }

        .slide-counter {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.6);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 14px;
            z-index: 10;
        }

        .price-tag { color: #e44d26; font-size: 24px; font-weight: bold; }
        .description-box { white-space: pre-line; line-height: 1.6; font-size: 15px; color: #444; }
        .sticky-sidebar { position: sticky; top: 20px; }

        input[type="datetime-local"]::-webkit-calendar-picker-indicator {
            cursor: pointer;
            filter: invert(0.5);
        }

        .alert-floating {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            min-width: 300px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            border: none;
            border-left: 5px solid #198754;
        }
    </style>
</head>
<body class="bg-light">

<% if (message && message.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show alert-floating" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>Thành công!</strong> <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="container mt-4 mb-5">
    <button onclick="goBack()" class="btn btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </button>
    <script>
    function goBack() {
        if (document.referrer.includes(window.location.origin)) {
            window.history.back();
        } else {
            window.location.href = '/';
        }
    }
    </script>
    <div class="row">
        <div class="col-md-7">
            <% if(room.images && room.images.length > 0) { %>
                <div id="roomCarousel" class="carousel slide shadow-sm rounded position-relative" data-bs-ride="carousel">
                    
                    <div class="carousel-indicators">
                        <% room.images.forEach((img, index) => { %>
                            <button type="button" data-bs-target="#roomCarousel" data-bs-slide-to="<%= index %>" 
                                class="<%= index === 0 ? 'active' : '' %>">
                            </button>
                        <% }) %>
                    </div>

                    <div class="carousel-inner rounded">
                        <% room.images.forEach((img, index) => { %>
                            <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                <img src="<%= img %>" class="d-block w-100" alt="Ảnh phòng">
                            </div>
                        <% }) %>
                    </div>

                    <div class="slide-counter">
                        <span id="currentSlideNum">1</span> / <%= room.images.length %>
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#roomCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#roomCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                    </button>
                </div>
            <% } %>

            <div class="mt-4 p-4 bg-white rounded shadow-sm border">
                <h5 class="fw-bold border-bottom pb-2 mb-3">Mô tả chi tiết</h5>
                <div class="description-box"><%= room.description %></div>
            </div>
        </div>
        
        <div class="col-md-5">
            <div class="bg-white p-4 shadow-sm rounded border sticky-sidebar">
                <h1 class="h3 fw-bold"><%= room.title %></h1>
                <p class="mb-1 text-muted">Mã phòng: <b class="text-primary"><%= room.code %></b></p>
                <p class="price-tag"><%= room.price.toLocaleString() %> VNĐ/tháng</p>
                <hr>
                
                <div class="row mb-3">
                    <div class="col-12 mb-2">
                        <b>📍 Khu vực:</b> <%= room.location %>
                    </div>
                    <div class="col-6 mb-2">
                        <b>🏠 Loại:</b> <%= room.type %>
                    </div>
                    <div class="col-6 mb-2">
                        <b>📐 Diện tích:</b> <%= room.area %> m²
                    </div>
                    
                    <% if (room.direction) { %>
                    <div class="col-12">
                        <b><i class="bi bi-compass"></i> Hướng:</b> <%= room.direction %>
                    </div>
                    <% } %>

                    <div class="col-12 mt-2 text-end">
                        <span class="badge <%= room.status ? 'bg-success' : 'bg-danger' %>">
                            <%= room.status ? 'Còn trống' : 'Đã hết' %>
                        </span>
                    </div>
                </div>
                <div class="mt-3">
                    <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(room.address + ', ' + room.location ) %>" 
                    target="_blank" 
                    class="btn btn-outline-danger btn-sm rounded-pill shadow-sm">
                        <i class="bi bi-geo-alt-fill"></i> Xem trên Google Maps
                    </a>
                </div>

                <div class="card mt-4 border-0 bg-light rounded-4">
                    <div class="card-body p-3">
                        <% if(room.status) { %>
                            <h5 class="card-title text-danger fw-bold mb-3"><i class="bi bi-calendar-check me-2"></i>Đăng ký đi xem phòng</h5>
                            <form action="/book" method="POST">
                                <input type="hidden" name="roomId" value="<%= room.id %>">
                                <input type="hidden" name="roomCode" value="<%= room.code %>">

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Họ tên của bạn</label>
                                    <input type="text" name="guestName" class="form-control" required placeholder="Nhập tên">
                                </div>

                                <% if (!user) { %>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Số điện thoại</label>
                                        <input type="tel" name="guestPhone" class="form-control" required placeholder="Nhập số điện thoại" pattern="[0-9]{10}" title="Vui lòng nhập đúng 10 chữ số">
                                    </div>
                                <% } %>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Chọn ngày & giờ hẹn</label>
                                    <input type="datetime-local" name="appointmentTime" class="form-control" required>
                                    <div class="form-text mt-1" style="font-size: 0.75rem;">Ấn vào biểu tượng 📅 để chọn lịch nhanh.</div>
                                </div>
                                <input type="hidden" name="roomTitle" value="<%= room.title %>">
                                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">Gửi yêu cầu xem phòng</button>
                            </form>
                        <% } else { %>
                            <div class="alert alert-danger mb-0 text-center fw-bold">PHÒNG ĐÃ HẾT</div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>

    const myCarousel = document.getElementById('roomCarousel');
    const currentSlideNum = document.getElementById('currentSlideNum');
    if(myCarousel) {
        myCarousel.addEventListener('slide.bs.carousel', event => {
            currentSlideNum.innerText = event.to + 1;
        });
    }

    setTimeout(() => {
        const alert = document.querySelector('.alert-floating');
        if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        }
    }, 4000);
</script>
</body>
</html>
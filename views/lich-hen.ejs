<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch hẹn xem phòng | PHONGTROHN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active">Lịch hẹn xem phòng</li>
            </ol>
        </nav>

        <h2 class="mb-4 fw-bold text-primary"><i class="bi bi-calendar-check-fill"></i> Lịch hẹn của bạn</h2>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-primary text-white">
                        <tr>
                            <th class="ps-4">Mã phòng</th>
                            <th>Tên phòng</th>
                            <th>Thời gian hẹn</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(userData.appointments && userData.appointments.length > 0) { %>
                            <% userData.appointments.forEach(appo => { %>
                                <tr>
                                    <td class="ps-4"><span class="fw-bold text-primary"><%= appo.room ? appo.room.code : 'N/A' %></span></td>
                                    <td><div class="text-truncate" style="max-width: 250px;"><%= appo.room ? appo.room.title : 'Phòng không tồn tại' %></div></td>
                                    <td>
                                        <div class="small fw-bold"><i class="bi bi-clock"></i> <%= appo.appointmentTime ? new Date(appo.appointmentTime).toLocaleString('vi-VN') : 'Chưa rõ' %></div>
                                    </td>
                                    <td>
                                        <% if(appo.status === 'Chờ xác nhận') { %>
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> <%= appo.status %></span>
                                        <% } else { %>
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> <%= appo.status %></span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <a href="/room/<%= appo.room ? appo.room._id : '#' %>" class="btn btn-sm btn-outline-primary rounded-pill">Chi tiết</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                                    Bạn chưa đặt lịch hẹn xem phòng nào.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
<%- include('partials/footer') %>
</html>
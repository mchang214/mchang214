<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #f8f9fa; margin: 0; }
        .navbar-custom { background-color: #0066ff !important; padding: 12px 0; }
        .header-flex-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }
        .nav-left, .nav-center, .nav-right {
            flex: 1;
            display: flex;
            align-items: center;
        }
        .nav-center { justify-content: center; }
        .nav-right { justify-content: flex-end; }
        .navbar-custom .nav-link { 
            color: rgba(255,255,255,0.9) !important; 
            font-weight: 500;
            margin: 0 10px;
            position: relative;
            white-space: nowrap; 
        }
        .navbar-custom .nav-link.active-page { 
            color: #fff !important; 
            font-weight: 700; 
        }
        .navbar-custom .nav-link.active-page::after {
            content: ""; position: absolute; bottom: -5px; left: 0; 
            width: 100%; height: 3px; background-color: #ffc107;
        }
        .user-nav-btn {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 18px;
            border-radius: 50px;
            color: white !important;
            transition: 0.3s;
            text-decoration: none;
            font-weight: 600;
            white-space: nowrap;
        }
        .user-nav-btn:hover { background: rgba(255, 255, 255, 0.25); color: #fff !important; }

        .contact-dropdown { position: relative; }
        .contact-btn {
            color: rgba(255,255,255,0.9) !important;
            cursor: pointer;
            display: flex; align-items: center; gap: 5px;
            text-decoration: none; font-weight: 500; padding: 8px 10px;
        }
        .contact-content {
            display: none; position: absolute; right: 0;
            background-color: white; min-width: 280px;
            box-shadow: 0px 10px 25px rgba(0,0,0,0.15);
            z-index: 1050; border-radius: 15px; padding: 20px; margin-top: 10px;
        }
        .contact-content.show { display: block; }
        .contact-header { color: #0066ff; font-weight: 700; border-bottom: 1px solid #f0f0f0; padding-bottom: 12px; margin-bottom: 15px; text-transform: uppercase; font-size: 0.8rem; }
        .contact-item { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; }
        .contact-icon { width: 40px; height: 40px; background-color: #eef4ff; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #0066ff; }
        .contact-info p { margin: 0; font-size: 0.75rem; color: #777; }
        .contact-info strong { color: #222; font-size: 1rem; display: block; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
    <div class="container">
        <div class="header-flex-container">
            
            <div class="nav-left">
                <a class="navbar-brand fw-bold" href="/">PHONGTROHN</a>
            </div>

            <div class="nav-center d-none d-lg-flex">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link <%= (page === 'home') ? 'active-page' : '' %>" href="/">Trang chủ</a>
                    </li>
                    <% if (user && isAdmin) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= (page === 'admin-add') ? 'active-page' : '' %>" href="/admin/add">Đăng bài</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= (page === 'admin-list') ? 'active-page' : '' %>" href="/admin">Bài đã đăng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= (page === 'admin-bookings') ? 'active-page' : '' %>" href="/admin/bookings">
                                Lịch hẹn khách 
                                <% if (locals.bookingCount > 0) { %>
                                    <span class="badge bg-danger rounded-pill ms-1"><%= bookingCount %></span>
                                <% } %>
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>

            <div class="nav-right">
                <div class="d-flex align-items-center gap-2">
                    <% if (!isAdmin) { %>
                        <div class="contact-dropdown">
                            <a class="contact-btn" onclick="toggleContact(event)">
                                <i class="bi bi-telephone-fill"></i> <span class="d-none d-sm-inline">Liên hệ</span> <i class="bi bi-chevron-down small"></i>
                            </a>
                            <div id="contactMenu" class="contact-content">
                                <div class="contact-header">Thông tin liên hệ</div>
                                <div class="contact-item">
                                    <div class="contact-icon"><i class="bi bi-headset fs-5"></i></div>
                                    <div class="contact-info"><p>Hotline 24/7</p><strong>0346.618.618</strong></div>
                                </div>
                                <div class="contact-item">
                                    <div class="contact-icon"><i class="bi bi-envelope-fill fs-5"></i></div>
                                    <div class="contact-info"><p>Email hỗ trợ</p><strong>phongtrohn01@gmail.com</strong></div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <% if (user) { %>
                        <a href="/logout" class="user-nav-btn">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                        </a>
                    <% } else { %>
                        <a href="/login" class="btn btn-outline-light rounded-pill px-4">Đăng nhập</a>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</nav>

<script>
    function toggleContact(event) {
        event.preventDefault();
        event.stopPropagation();
        const menu = document.getElementById("contactMenu");
        if(menu) menu.classList.toggle("show");
    }

    window.onclick = function(event) {
        if (!event.target.closest('.contact-dropdown')) {
            const dropdown = document.getElementById("contactMenu");
            if (dropdown && dropdown.classList.contains('show')) {
                dropdown.classList.remove("show");
            }
        }
    }
</script>
<input type="hidden" id="chat-user-id" value="<%= user ? user._id : 'guest' %>">

<script src="/js/chatbot.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
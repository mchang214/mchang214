<style>
    .navbar { z-index: 1050; }
    .navbar-nav .nav-item .nav-link {
        color: rgba(255, 255, 255, 0.7) !important; 
        font-weight: 500 !important; 
        font-size: 15px;
        transition: all 0.2s ease;
        position: relative;
        padding: 0.5rem 1rem !important;
    }
    .navbar-nav .nav-item .nav-link.active-page {
        color: #ffffff !important; 
        font-weight: 800 !important; 
    }
    .navbar-nav .nav-item .nav-link.active-page::after {
        content: ""; position: absolute; bottom: 0; left: 20%; width: 60%; height: 3px; background-color: white; border-radius: 10px;
    }
    .dropdown-menu {
        min-width: 280px; border-radius: 15px !important; border: none !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important; overflow: hidden;
    }
    .contact-icon-box {
        width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
        background-color: rgba(13, 110, 253, 0.1); border-radius: 10px; color: #0d6efd;
    }
    .user-dropdown-custom .dropdown-toggle::after { display: none; }
    .user-btn-pill {
        background: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255, 255, 255, 0.4);
        padding: 5px 15px !important; border-radius: 50px; color: white !important;
        transition: 0.3s; text-decoration: none; display: flex; align-items: center; gap: 8px;
    }
    .user-btn-pill:hover { background: rgba(255, 255, 255, 0.3); }

    @media (max-width: 991.98px) {
        .navbar-collapse { background: rgba(0, 0, 0, 0.1); padding: 1rem; border-radius: 15px; margin-top: 10px; backdrop-filter: blur(5px); }
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4 sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold text-white d-flex align-items-center" href="/">
            <i class="bi bi-house-heart-fill me-2"></i> PHONGTROHN
        </a>
        
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavMain">
            <ul class="navbar-nav ms-auto align-items-center">
                
                <li class="nav-item dropdown me-lg-2">
                    <a class="nav-link dropdown-toggle" href="#" id="contactDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-telephone-fill me-1"></i> Liên hệ
                    </a>
                    <div class="dropdown-menu dropdown-menu-end p-4 shadow-lg border-0 rounded-4" aria-labelledby="contactDropdown">
                        <h6 class="fw-bold border-bottom pb-3 mb-3 text-uppercase text-primary">Thông tin liên hệ</h6>
                        <div class="d-flex align-items-center mb-3">
                            <div class="contact-icon-box me-3"><i class="bi bi-headset fs-5"></i></div>
                            <div>
                                <small class="text-muted d-block">Hotline 24/7</small>
                                <span class="fw-bold text-dark">0346.618.618</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <div class="contact-icon-box me-3"><i class="bi bi-envelope-fill fs-5"></i></div>
                            <div>
                                <small class="text-muted d-block">Email hỗ trợ</small>
                                <span class="fw-bold text-dark">phongtrohn01@gmail.com</span>
                            </div>
                        </div>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link <%= (typeof page !== 'undefined' && page === 'home') ? 'active-page' : '' %>" href="/">Trang chủ</a>
                </li>
                
                <% if (locals.user) { %>
                    <% if (locals.isAdmin) { %>
                        <li class="nav-item"><a class="nav-link <%= (page === 'admin-bookings') ? 'active-page' : '' %>" href="/admin/bookings">Lịch hẹn khách</a></li>
                        <li class="nav-item"><a class="nav-link <%= (page === 'admin-add') ? 'active-page' : '' %>" href="/admin/add" style="color: #ffc107 !important;">Đăng bài</a></li>
                        <li class="nav-item"><a class="nav-link <%= (page === 'admin-list') ? 'active-page' : '' %>" href="/admin" style="color: #ffc107 !important;">Bài đã đăng</a></li>
                    <% } else { %>
                        <li class="nav-item"><a class="nav-link <%= (page === 'da-luu') ? 'active-page' : '' %>" href="/da-luu">Mục đã lưu</a></li>
                        <li class="nav-item"><a class="nav-link <%= (page === 'lich-hen') ? 'active-page' : '' %>" href="/lich-hen">Lịch hẹn</a></li>
                    <% } %>

                    <li class="nav-item dropdown user-dropdown-custom ms-lg-3">
                        <a class="dropdown-toggle user-btn-pill" href="#" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span>Chào, <strong><%= user.name || user.phone %></strong></span>
                            <i class="bi bi-chevron-down small"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2" aria-labelledby="userMenu">
                            <li><a class="dropdown-item py-2" href="/change-password"><i class="bi bi-shield-lock me-2 text-primary"></i>Đổi mật khẩu</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </li>

                <% } else { %>
                    <li class="nav-item ms-lg-3">
                        <a href="/login" class="btn btn-light btn-sm rounded-pill px-4 fw-bold text-primary w-100 shadow-sm border-2">Đăng nhập</a>
                    </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>
<input type="hidden" id="chat-user-id" value="<%= user ? user._id : 'guest' %>">

<script src="/js/chatbot.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>